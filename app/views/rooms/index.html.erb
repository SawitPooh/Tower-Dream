<p style="color: green"><%= notice %></p>

<% content_for :title, "Rooms" %>

<h1>Rooms</h1>
<p>
<%= link_to "Summary", rooms_summary_path %>
</p>
<div id="rooms">
  <% @rooms.each do |room| %>
    <%= render room %>
      <%= link_to "Edit", edit_room_path(room) %>    
      <%= link_to "Show this room", room %>
      <p>
      <%= button_to "Delete", room, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }%>
      </p>
  <% end %>
</div>
<p>
<%= link_to "New room", new_room_path %>
</p>


